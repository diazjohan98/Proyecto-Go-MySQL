{{ define "inicio" }}

{{ template "cabecera" }}

<a name="" id="" class="btn btn-primary" href="/crear" role="button"
  >Agregar empleado</a
>

<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Nombre</th>
      <th>Correo</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    {{ range. }}
    <tr>
      <th scope="row">{{ .Id }}</th>
      <td>{{ .Nombre }}</td>
      <td>{{ .Correo }}</td>
      <td>
        Editar {{ .Id }} |
        <a
          name=""
          id=""
          class="btn btn-danger"
          href="/borrar?id={{.Id}}"
          role="button"
          >Borrar</a
        >
      </td>
    </tr>
  </tbody>
  {{
    end
  }}
</table>

{{ template "pie" }}

{{ end }}

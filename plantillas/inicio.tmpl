{{ define "inicio" }}
{{ template "cabecera" }}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="text-secondary font-weight-bold">Lista de Empleados</h3>
  <a class="btn btn-info shadow-sm" href="/crear">Agregar Empleado</a>
</div>

<div class="card shadow-sm mb-5">
  <div class="card-body">
    <div class="table-responsive">
      <table
        id="tablaEmpleados"
        class="table table-hover table-striped mb-0 text-center w-100"
      >
        <thead>
          <tr>
            <th class="align-middle">ID</th>
            <th class="align-middle">Nombre</th>
            <th class="align-middle">Correo</th>
            <th class="align-middle">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{ range . }}
          <tr>
            <th class="align-middle" scope="row">{{ .Id }}</th>
            <td class="align-middle">{{ .Nombre }}</td>
            <td class="align-middle">{{ .Correo }}</td>
            <td class="align-middle">
              <a
                class="btn btn-warning btn-sm shadow-sm mr-2"
                href="/editar?id={{.Id}}"
                >Editar</a
              >
              <a
                class="btn btn-danger btn-sm shadow-sm"
                href="/borrar?id={{.Id}}"
                onclick="return confirm('¿Estás seguro de eliminar a {{.Nombre}}?');"
                >Borrar</a
              >
            </td>
          </tr>
          {{
            end
          }}
        </tbody>
      </table>
    </div>
  </div>
</div>

{{ template "pie" }}
{{ end }}
